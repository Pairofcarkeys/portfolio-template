      "$value": "#ffffff"
    },
    "muted": {
      "$type": "color",
      "$value": "#6b6b6b"
    },
    "faint": {
      "$type": "color",
      "$value": "#a3a3a3"
    },
    "rule": {
      "$type": "color",
      "$value": "#0b0b0b"
    },
    "hairline": {
      "$type": "color",
      "$value": "#dcdcdc"
    },
    "surface": {
      "$type": "color",
      "$value": "#f3f3f3"
    },
    "accent": {
      "$type": "color",
      "$value": "#8a0303"
    },
    "accent-ink": {
      "$type": "color",
      "$value": "#6e0202"
    },
