{
  "name": "portfolio-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/publish-social-summary.mjs && next build",
    "start": "wrangler pages dev out --port 8004",
    "preview": "pnpm build && pnpm start",
    "deploy": "pnpm check && wrangler pages deploy out --project-name=your-portfolio --branch=main",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify-site.mjs && node --test tests/*.test.mjs",
    "sync:contributions": "node scripts/sync-contributions.mjs",
    "sync:playlists": "python3 scripts/sync-playlists.py",
    "capture:work": "python3 scripts/capture-design-work.py",
    "capture:work:phone": "python3 scripts/capture-design-work.py --phone",
    "design:figma": "node design/build-figma.mjs",
    "refresh": "node scripts/refresh-data.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "motion": "^12.38.0",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.186.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.81.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <23"
  },
  "license": "MIT"
}
