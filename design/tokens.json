  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Inter Tight",
        "Helvetica Neue",
        "Helvetica",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "Menlo",
        "monospace"
      ]
    }
