      "$type": "dimension",
      "$value": "1440px"
    },
    "edge": {
      "$type": "dimension",
      "$value": "36px",
      "$description": "clamp(16px, 2.5vw, 40px); 16px on phones"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "23px",
      "$description": "clamp(12px, 1.6vw, 24px)"
    },
    "columns": {
      "$type": "number",
      "$value": 12
